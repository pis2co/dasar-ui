{
  "name": "dasar-ui",
  "version": "1.9.0",
  "author": "dxxta",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "lib:create": "bash -c 'read -p \"name: \" NAME && ng generate component $NAME --project=dasar-ui'",
    "git:patch:push": "bash -c 'read -p \"branch: \" BRANCH && npm run git:patch && git push --follow-tags origin HEAD:refs/heads/$BRANCH'",
    "git:minor:push": "bash -c 'read -p \"branch: \" BRANCH && npm run git:minor && git push --follow-tags origin HEAD:refs/heads/$BRANCH'",
    "git:major:push": "bash -c 'read -p \"branch: \" BRANCH && npm run git:major && git push --follow-tags origin HEAD:refs/heads/$BRANCH'",
    "git:patch": "npx standard-version --release-as patch",
    "git:minor": "npx standard-version --release-as minor",
    "git:major": "npx standard-version --release-as major",
    "release:build": "npm run build:library",
    "release:publish": "npm publish dist/dasar-ui --access public",
    "start": "ng serve documentation --port 5200",
    "start:docs": "ng serve documentation --port 5200",
    "build:docs": "ng build documentation",
    "docker:build": "docker build -t dasar-ui-documentation .",
    "docker:run": "docker run --rm -p 4000:4000 dasar-ui-documentation",
    "serve:ssr:docs": "node dist/documentation/server/server.mjs",
    "clean": "npx rimraf .angular .vite node_modules package-lock.json",
    "watch:library": "ng build dasar-ui --watch --configuration development",
    "build:library": "ng build dasar-ui",
    "test": "ng test",
    "ng": "ng"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/prismjs": "1.26.6",
    "jsdom": "^28.0.0",
    "marked": "18.1.1",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "standard-version": "^9.5.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "vitest": "~4.0.8"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "express": "^5.1.0",
    "prismjs": "1.30.0",
    "rxjs": "~7.8.0"
  }
}
